set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_SOURCE_DIR}/source/common/core/EngineConfig.hpp")
file(READ "${CMAKE_SOURCE_DIR}/source/common/core/EngineConfig.hpp" version_header)
foreach(part MAJOR MINOR PATCH)
    string(REGEX MATCH "VERSION_${part} = ([0-9]+)" match "${version_header}")
    set(version_${part} "${CMAKE_MATCH_1}")
endforeach()
set(OPENCRAFT_VERSION "${version_MAJOR}.${version_MINOR}.${version_PATCH}")
string(REGEX MATCH "VERSION_SUFFIX = \"([^\"]*)\"" match "${version_header}")
if(CMAKE_MATCH_1)
    string(APPEND OPENCRAFT_VERSION "-${CMAKE_MATCH_1}")
endif()

if(APPLE)
    set(payload "OpenCraft.app/Contents/Resources/opencraft")
    install(PROGRAMS "$<TARGET_FILE:opencraft>" DESTINATION OpenCraft.app/Contents/MacOS
        RENAME opencraft-bin COMPONENT Runtime)
    add_executable(opencraft_launcher packaging/macos-launcher.cpp)
    target_compile_features(opencraft_launcher PRIVATE cxx_std_17)
    set_target_properties(opencraft_launcher PROPERTIES OUTPUT_NAME opencraft
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/launcher")
    add_dependencies(opencraft opencraft_launcher)
    install(TARGETS opencraft_launcher RUNTIME DESTINATION OpenCraft.app/Contents/MacOS COMPONENT Runtime)
    configure_file(packaging/Info.plist.in "${CMAKE_BINARY_DIR}/Info.plist" @ONLY)
    install(FILES "${CMAKE_BINARY_DIR}/Info.plist" DESTINATION OpenCraft.app/Contents COMPONENT Runtime)
elseif(WIN32)
    set(payload ".")
    install(TARGETS opencraft RUNTIME DESTINATION . COMPONENT Runtime)
    install(FILES packaging/opencraft.cmd DESTINATION . COMPONENT Runtime)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_COMPONENT Runtime)
    include(InstallRequiredSystemLibraries)
else()
    set(payload "share/opencraft")
    install(PROGRAMS "$<TARGET_FILE:opencraft>" DESTINATION bin RENAME opencraft-bin COMPONENT Runtime)
    install(PROGRAMS packaging/opencraft.sh DESTINATION bin RENAME opencraft COMPONENT Runtime)
    install(FILES packaging/opencraft.desktop DESTINATION share/applications COMPONENT Runtime)
    install(FILES resources/textures/world_icon.png DESTINATION share/icons/hicolor/16x16/apps
        RENAME opencraft.png COMPONENT Runtime)
endif()
install(DIRECTORY mods resources docs DESTINATION "${payload}" COMPONENT Runtime
    PATTERN "*.sc" EXCLUDE)
install(FILES LICENSE CONTRIBUTORS.md README.md DESTINATION "${payload}" COMPONENT Runtime)
file(GLOB dependencies RELATIVE "${CMAKE_SOURCE_DIR}/external" "${CMAKE_SOURCE_DIR}/external/*")
foreach(dependency IN LISTS dependencies)
    file(GLOB licenses "${CMAKE_SOURCE_DIR}/external/${dependency}/LICENSE*"
        "${CMAKE_SOURCE_DIR}/external/${dependency}/COPYING*")
    if(licenses)
        install(FILES ${licenses} DESTINATION "${payload}/licenses/${dependency}" COMPONENT Runtime)
    endif()
endforeach()

set(CPACK_PACKAGE_NAME opencraft)
set(CPACK_PACKAGE_VENDOR "opencraft contributors")
set(CPACK_PACKAGE_CONTACT "opencraft contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A free and libre block-building game")
set(CPACK_PACKAGE_VERSION "${OPENCRAFT_VERSION}")
set(CPACK_PACKAGE_VERSION_MAJOR "${version_MAJOR}")
set(CPACK_PACKAGE_VERSION_MINOR "${version_MINOR}")
set(CPACK_PACKAGE_VERSION_PATCH "${version_PATCH}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};opencraft;Runtime;/")
set(CPACK_PACKAGE_FILE_NAME "opencraft-${OPENCRAFT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(CPACK_PACKAGE_FILE_NAME "opencraft-${OPENCRAFT_VERSION}-windows-x64")
    else()
        set(CPACK_PACKAGE_FILE_NAME "opencraft-${OPENCRAFT_VERSION}-windows-x86")
    endif()
elseif(UNIX AND NOT APPLE)
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    set(CPACK_GENERATOR "DEB;RPM")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_SECTION games)
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_PACKAGE_LICENSE "LGPL-2.1-or-later AND CC-BY-SA-4.0")
    set(CPACK_RPM_PACKAGE_GROUP "Amusements/Games")
endif()
include(CPack)
