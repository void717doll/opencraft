    "version": "2.0.0",
    "tasks": [
        {
            "label": "(Windows) Configure OpenCraft using MinGW",
            "type": "shell",
            "command": "cmake",
            "args": ["-B", "build_mingw", "-G", "MinGW Makefiles", "."]
        },
        {
            "label": "Compile OpenCraft using MinGW",
            "type": "shell",
            "command": "cmake --build build_mingw -j8",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "(Windows) Configure OpenCraft using MinGW"
        }
    ]
}